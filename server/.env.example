# ===== 서버 환경변수 예시 (실제 값은 .env 또는 Vercel 프로젝트의 Environment Variables에 입력) =====

# 로컬 개발에서만 사용 (Vercel에서는 무시됨)
PORT=5001

# MongoDB Atlas 주소. 값이 없거나 비어 있으면 로컬(mongodb://127.0.0.1:27017/shopping-mall-demo)을 사용
# Atlas의 <db_password> 자리표시자를 실제 비밀번호로 바꾸고 < > 는 지울 것 (특수문자는 %40 처럼 인코딩)
MONGODB_ATLAS_URL=

# 로그인 토큰 서명 키. 길고 무작위인 값으로 (운영에서는 개발용과 다른 새 값을 사용)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# 클라이언트(프론트엔드) 주소. 쉼표로 여러 개 가능. 운영에서는 이 주소에서 온 요청만 허용
# 예) https://my-shop.vercel.app
CLIENT_URL=http://localhost:5174

# 포트원(아임포트) REST API 키 (결제 검증용, 서버에서만 사용)
PORTONE_API_KEY=
PORTONE_API_SECRET=

# ---------- 개발 전용: 운영(Vercel)에는 절대 넣지 말 것 ----------
# true면 비밀번호 재설정 링크를 응답에 그대로 내려줌 -> 운영에서 켜면 누구나 남의 비밀번호를 바꿀 수 있음
EXPOSE_RESET_LINK=false
# true면 포트원 테스트(샌드박스) 결제도 인정 -> 운영에서 켜면 가짜 결제로 주문이 확정될 수 있음
PORTONE_INCLUDE_SANDBOX=false
