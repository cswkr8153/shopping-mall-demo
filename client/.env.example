# ===== 클라이언트 환경변수 예시 (Vercel 프로젝트의 Environment Variables에 입력) =====
# VITE_ 로 시작하는 값은 빌드할 때 화면 코드에 포함되어 누구나 볼 수 있음 -> 비밀 값(REST API Secret 등)은 절대 넣지 말 것
# 값을 바꾸면 다시 배포(빌드)해야 반영됨

# 서버(백엔드) API 주소.
#  - 로컬 개발: 비워 두거나 /api (vite 프록시가 localhost:5001로 전달)
#  - 운영(Vercel): 서버 프로젝트 주소 + /api   예) https://my-shop-api.vercel.app/api
VITE_API_URL=/api

# Cloudinary 이미지 업로드 (Cloudinary 콘솔 > Settings > Upload > Upload presets 에서 Unsigned 프리셋 생성)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# 포트원 가맹점(고객사) 식별코드 (imp로 시작). REST API 키/시크릿이 아님
VITE_PORTONE_IMP_CODE=
# 결제 PG. 기본값 html5_inicis (KG이니시스). 채널을 따로 지정했다면 변경
# VITE_PORTONE_PG=html5_inicis
